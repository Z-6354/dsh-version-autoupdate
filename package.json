{
  "name": "dsh-version-autoupdate",
  "version": "0.3.21",
  "description": "Draggable floating version capsule (restored from 0.3.7) + one-click update.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/dsh-restart.mjs",
    "lib/offline-install.mjs",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src/client.tsx"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:client && tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/dsh-restart.mjs','lib/dsh-restart.mjs');fs.copyFileSync('src/offline-install.mjs','lib/offline-install.mjs')\"",
    "prepack": "node -e \"process.exit(0)\"",
    "test": "npm run build && node --test tests/*.spec.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "version",
    "autoupdate",
    "updater"
  ],
  "author": "han0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-version-autoupdate.git"
  },
  "bugs": {
    "url": "https://github.com/Z-6354/dsh-version-autoupdate/issues"
  },
  "homepage": "https://github.com/Z-6354/dsh-version-autoupdate#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}

{
  "name": "dsh-version-autoupdate",
  "version": "0.3.22",
  "description": "DSH version capsule with verified install targets, lifecycle cleanup, and a three-step update workflow.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.mjs",
    "lib/**/*.d.mts",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src/**/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:client && tsc -p tsconfig.json && node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('src'))if(f.endsWith('.mjs')||f.endsWith('.d.mts')||f.endsWith('.d.ts'))fs.copyFileSync('src/'+f,'lib/'+f)\"",
    "prepack": "npm run build",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "test": "npm run typecheck:client && npm run build && node --test tests/*.spec.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "version",
    "autoupdate",
    "updater"
  ],
  "author": "han0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-version-autoupdate.git"
  },
  "bugs": {
    "url": "https://github.com/Z-6354/dsh-version-autoupdate/issues"
  },
  "homepage": "https://github.com/Z-6354/dsh-version-autoupdate#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.8 || ^0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}

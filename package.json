{
  "name": "dsh-version-autoupdate",
  "version": "0.3.61",
  "description": "Draggable floating version capsule (restored from 0.3.7) + one-click update.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/dsh-restart.mjs",
    "lib/offline-install.mjs",
    "lib/promote-and-boot.mjs",
    "lib/client.js.map",
    "cordis.patch.yml",
    "src/client.tsx",
    "src/dsh-restart.mjs",
    "src/offline-install.mjs",
    "README.md",
    "AGENTS.md",
    "docs/**/*.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"console.log('lib-first layout: refuse to rm lib; delete files manually if needed')\"",
    "build:client": "node -e \"console.log('build:client skipped (no scripts/build-client.mjs in this checkout)'); process.exit(0)\"",
    "sync": "node scripts/sync-runtime.mjs",
    "build": "node scripts/sync-runtime.mjs",
    "prepack": "node scripts/sync-runtime.mjs",
    "test": "node scripts/sync-runtime.mjs && node --test tests/*.spec.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "version",
    "autoupdate",
    "updater"
  ],
  "author": "han0423",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z-6354/dsh-version-autoupdate.git"
  },
  "bugs": {
    "url": "https://github.com/Z-6354/dsh-version-autoupdate/issues"
  },
  "homepage": "https://github.com/Z-6354/dsh-version-autoupdate#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.8 || ^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
